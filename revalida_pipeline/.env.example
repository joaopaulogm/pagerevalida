# PostgreSQL / Supabase
DATABASE_URL=postgresql://user:password@localhost:5432/revalida
# Para Supabase: postgresql://postgres:PageRevalida123@db.[PROJECT].supabase.co:5432/postgres

# Diretórios de dados
DATA_DIR=./data
RAW_DIR=./data/raw
IMAGES_DIR=./data/images
PARSED_DIR=./data/parsed

# Configurações de download
DOWNLOAD_TIMEOUT=60
MAX_RETRIES=3
RETRY_WAIT=5
USER_AGENT=Mozilla/5.0 (compatible; RevalidaPipeline/1.0)

# OCR
TESSERACT_CMD=tesseract
OCR_LANG=por+eng

# Confiança mínima para não marcar revisão manual
MIN_CONFIDENCE_SCORE=0.7

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/pipeline.log
