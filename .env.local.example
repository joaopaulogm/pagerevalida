# =============================================================================
# VARIÁVEIS DE AMBIENTE — Page Revalida
# =============================================================================
# INSTRUÇÃO: Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite .env.local no repositório.
# Obtenha os valores em: Vercel Dashboard → Storage → seu banco → .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Vercel Postgres (Neon) — geradas automaticamente pelo Vercel
# -----------------------------------------------------------------------------

# URL de conexão com pool (uso geral na aplicação)
POSTGRES_URL="postgres://app_user:<senha>@<host>.neon.tech/<db>?sslmode=require"

# URL para Prisma (com pgbouncer=true para compatibilidade)
POSTGRES_PRISMA_URL="postgres://app_user:<senha>@<host>.neon.tech/<db>?sslmode=require&pgbouncer=true&connect_timeout=15"

# URL sem pool (para migrations e comandos DDL que não funcionam com PgBouncer)
POSTGRES_URL_NON_POOLING="postgres://app_user:<senha>@<host>.neon.tech/<db>?sslmode=require"

# Credenciais individuais (usadas pelo pg package se necessário)
POSTGRES_USER="app_user"
POSTGRES_PASSWORD="<senha-app-user>"
POSTGRES_HOST="<host>.neon.tech"
POSTGRES_DATABASE="<nome-do-banco>"

# -----------------------------------------------------------------------------
# Credenciais das roles (usadas apenas em scripts de deploy/migration)
# Não use em runtime da aplicação
# -----------------------------------------------------------------------------
APP_USER_PASSWORD="<senha-forte-app-user>"
APP_ADMIN_PASSWORD="<senha-forte-app-admin>"
APP_READONLY_PASSWORD="<senha-forte-app-readonly>"

# -----------------------------------------------------------------------------
# Chave de criptografia simétrica (pgcrypto: pgp_sym_encrypt)
# Usada para CPF e IDs externos de pagamento
# SECURITY: Gere com: openssl rand -base64 32
# -----------------------------------------------------------------------------
APP_SECRET_KEY="<chave-de-32-bytes-em-base64>"

# -----------------------------------------------------------------------------
# Ambiente
# -----------------------------------------------------------------------------
NODE_ENV="development"
